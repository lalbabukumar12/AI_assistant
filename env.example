# ==============================================================================
# AI Assistant - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root:
#   cp env.example .env
#
# All values are loaded by dotenv at application startup.
# Paths containing spaces or backslashes should be enclosed in quotes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Configuration (Required for AI responses)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from Google AI Studio:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------------------------
# 2. Speech Recognition Provider Selection
# ------------------------------------------------------------------------------
# Choose which engine transcribes voice and system audio:
#   - 'whisper' : Local, offline transcription via OpenAI Whisper (Recommended)
#   - 'azure'   : Cloud transcription via Microsoft Azure Cognitive Services
#   - leave blank or 'disabled' to disable speech recognition
SPEECH_PROVIDER=whisper


# ------------------------------------------------------------------------------
# 3. Local Whisper Configuration (Used when SPEECH_PROVIDER=whisper)
# ------------------------------------------------------------------------------
# Path or command for the Whisper CLI.
# Examples:
#   - Windows (Virtual Env) : .venv-whisper\Scripts\whisper.exe
#   - macOS/Linux (Venv)    : .venv-whisper/bin/whisper
#   - System-wide install   : whisper  or  python -m whisper
WHISPER_COMMAND=.venv-whisper\Scripts\whisper.exe

# Path to the Python executable in the virtual environment.
# Powers the persistent background Python worker (scripts/whisper_worker.py)
# for zero-spawn inference latency and PyTorch GPU memory caching.
# Examples:
#   - Windows : .venv-whisper\Scripts\python.exe
#   - macOS/Linux : .venv-whisper/bin/python
WHISPER_PYTHON=.venv-whisper\Scripts\python.exe

# Whisper Model size:
# Options: 'tiny', 'base', 'small', 'medium', 'turbo'
# Default: 'small' (optimal balance of latency and technical English accuracy)
WHISPER_MODEL=small

# Spoken language code:
# Options: 'en' (English), 'auto' (detect automatically), 'es', 'de', 'fr', etc.
# Setting 'en' skips automatic language identification and reduces latency.
WHISPER_LANGUAGE=auto

# Inference execution device:
#   - 'auto' : Automatically uses CUDA if an NVIDIA GPU is detected, else CPU
#   - 'cuda' : Force NVIDIA GPU acceleration (requires CUDA-enabled PyTorch)
#   - 'cpu'  : Force CPU execution
WHISPER_DEVICE=auto

# Audio capture & segmentation mode:
#   - 'vad'    : Voice Activity Detection (Recommended). Listens for speech pauses
#                and automatically flushes natural sentences/utterances.
#   - 'manual' : Records continuously until the mic button or shortcut is pressed again.
WHISPER_CAPTURE_MODE=vad

# Voice response routing:
# Where AI answers should be displayed:
#   - 'both'    : Floating HUD overlay + Multi-turn Chat window (Default)
#   - 'overlay' : Floating HUD overlay only
#   - 'chat'    : Chat window only
WHISPER_RESPONSE_TARGET=both

# Segment length in milliseconds for streaming audio ingestion (default: 4000)
WHISPER_SEGMENT_MS=4000

# Safety timeout (in milliseconds) for continuous manual recording (default: 90000)
WHISPER_MANUAL_MAX_MS=90000

# Inactivity delay (in milliseconds) before unloading model weights from GPU memory (default: 60000)
WHISPER_GPU_IDLE_MS=60000

# Optional custom directory for downloading and storing Whisper model weights.
# Leave unset to use the default platform directory:
#   - Windows : %APPDATA%\ai-assistant\.whisper-models
#   - macOS   : ~/Library/Application Support/ai-assistant/.whisper-models
#   - Linux   : ~/.config/ai-assistant/.whisper-models
# WHISPER_MODEL_DIR=


# ------------------------------------------------------------------------------
# 4. System Audio Loopback & Interviewer Listening Logic
# ------------------------------------------------------------------------------
# Audio capture source:
#   - 'both'   : Captures both system loopback (interviewer) AND local microphone (you)
#   - 'system' : Captures only system output audio (interviewer's voice)
#   - 'mic'    : Captures only local microphone input (your voice)
AUDIO_SOURCE=both

# Audio device ID to capture:
#   - 'default' : Automatically taps into your default system audio output loopback.
#   - Or select a specific device ID from the Settings UI dropdown (Ctrl+,).
AUDIO_DEVICE_ID=default

# Interviewer Listening Mode:
#   - 'manual-answer' : (Recommended for interviews)
#                       Transcribes the interviewer's voice into a rolling buffer and
#                       displays it live in the Chat window tagged as "Interviewer".
#                       Does NOT trigger the LLM automatically mid-sentence.
#                       When you want an answer, press the "Answer" button (Ctrl+Shift+A),
#                       which coalesces recent speech and streams the solution.
#   - 'continuous'    : Automatically triggers an LLM answer whenever a pause in speech is detected.
LISTEN_MODE=manual-answer

# Duration (in seconds) of the rolling interviewer utterance buffer.
# Utterances older than this window are pruned from memory (default: 60 seconds).
INTERVIEWER_BUFFER_SECONDS=60


# ------------------------------------------------------------------------------
# 5. Azure Cognitive Services Speech Configuration (Optional)
# ------------------------------------------------------------------------------
# Required only if SPEECH_PROVIDER=azure:
# Sign up at: https://azure.microsoft.com/services/cognitive-services/speech-services/
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here


# ------------------------------------------------------------------------------
# 6. Logging & Development Environment
# ------------------------------------------------------------------------------
# Logging verbosity: 'debug', 'info', 'warn', 'error' (default: 'info')
# LOG_LEVEL=info

# Node environment: 'development' or 'production'
# NODE_ENV=development
